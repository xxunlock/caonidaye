APP_NAME=Crypto Quant Assistant
ENV=dev
DEBUG=true
API_PREFIX=/api/v1

# 逗号分隔的交易对
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAME=1m
ANOMALY_PRICE_THRESHOLD_PCT=2.5
ANOMALY_VOLUME_MULTIPLIER=2.0
WHALE_ORDER_USD_THRESHOLD=500000
WEBSOCKET_BROADCAST_INTERVAL_SEC=2

# LLM 配置
LLM_PROVIDER=openai
OPENAI_API_KEY=
LOCAL_LLM_URL=http://localhost:8001/v1/chat/completions

# Telegram 配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 邮件配置
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
